FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY sopassist/ ./sopassist/

COPY data/sops/ ./data/sops/
COPY data/access_policy.json ./data/access_policy.json
COPY data/staff_users.csv ./data/staff_users.csv

ENV PYTHONUNBUFFERED=1
ENV DATA_DIR=/app/data
ENV DB_PATH=/tmp/sop_index.db

EXPOSE 8000

CMD ["sh", "-c", "python -m sopassist.ingest.cli /app/data/sops && uvicorn sopassist.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
