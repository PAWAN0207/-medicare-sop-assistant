FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy only application code and sanitized demo data
COPY sopassist/ ./sopassist/
COPY data/demo/ ./data/demo/

ENV PYTHONUNBUFFERED=1
ENV DATA_DIR=/app/data/demo
ENV DB_PATH=/tmp/sop_index.db

EXPOSE 8000

CMD ["sh", "-c", "python -m sopassist.ingest.cli /app/data/demo/sops && uvicorn sopassist.main:app --host 0.0.0.0 --port ${PORT:-8000}"]


