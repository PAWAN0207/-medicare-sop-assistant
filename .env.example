# Copy to .env (make setup does this). .env is git-ignored and loaded automatically; real env vars override it.
# --- provider: "fake" (offline, no key) or "openai_compat" (any OpenAI-compatible API) ---
PROVIDER=fake

# Gemini free tier (get a key at https://aistudio.google.com/apikey). Never commit .env.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
# Model names rotate: if you get a 404, pick a current one from https://aistudio.google.com
LLM_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2
# used only to estimate cost in logs (USD per 1M tokens)
PRICE_IN_PER_1M_USD=0.10
PRICE_OUT_PER_1M_USD=0.40

DB_PATH=var/sop_index.db
DATA_DIR=data
SEARCH_MODE=hybrid
TOP_K=6
# relevance gate (re-tune with `make eval-live` when you switch embedding models)
MIN_TERM_COVERAGE=0.55
MIN_COSINE=0.99
CACHE_TTL_S=86400
MAX_REMOVAL_FRACTION=0.5
LOG_LEVEL=INFO
