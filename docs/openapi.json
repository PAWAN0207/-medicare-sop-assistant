{
  "openapi": "3.1.0",
  "info": {
    "title": "MediCare SOP Assistant",
    "description": "Answers clinic staff questions from current SOPs, with citations and role-based access.",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/ask": {
      "post": {
        "tags": [
          "qa"
        ],
        "summary": "Ask",
        "operationId": "ask_v1_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "403": {
            "description": "UNKNOWN_USER",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "INVALID_REQUEST | PATIENT_DATA_DETECTED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "UPSTREAM_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "INDEX_EMPTY",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "UPSTREAM_TIMEOUT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "Staff id from staff_users.csv",
            "examples": [
              "U2001"
            ]
          },
          "question": {
            "type": "string",
            "title": "Question",
            "examples": [
              "What is the procedure for a needle-stick injury?"
            ]
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "question"
        ],
        "title": "AskRequest"
      },
      "AskResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "refused": {
            "type": "boolean",
            "title": "Refused",
            "description": "true when the SOPs available to this user do not cover the question"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "description": "no_relevant_sop | llm_not_covered | ungrounded (only when refused)",
            "default": ""
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/CitationOut"
            },
            "type": "array",
            "title": "Citations"
          },
          "cached": {
            "type": "boolean",
            "title": "Cached"
          },
          "index_generation": {
            "type": "integer",
            "title": "Index Generation"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "refused",
          "citations",
          "cached",
          "index_generation",
          "request_id"
        ],
        "title": "AskResponse"
      },
      "CitationOut": {
        "properties": {
          "sop_id": {
            "type": "string",
            "title": "Sop Id"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "section": {
            "type": "string",
            "title": "Section"
          },
          "section_title": {
            "type": "string",
            "title": "Section Title"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          }
        },
        "type": "object",
        "required": [
          "sop_id",
          "version",
          "title",
          "section",
          "section_title",
          "page"
        ],
        "title": "CitationOut"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details",
            "default": {}
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      }
    }
  }
}
